{
  "name": "baghchal-app",
  "version": "0.1.0",
  "private": true,
  "main": "expo-router/entry",
  "scripts": {
    "start": "expo start",
    "web": "expo start --web",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "typecheck": "tsc --noEmit",
    "lint": "eslint . --max-warnings 0",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "jest",
    "test:ci": "jest --ci --coverage",
    "guardrails": "node scripts/check-guardrails.mjs",
    "api:generate": "openapi-typescript src/api/openapi.json -o src/api/schema.d.ts",
    "api:check": "openapi-typescript src/api/openapi.json -o src/api/schema.d.ts --check",
    "export:web": "expo export --platform web",
    "e2e:smoke": "node e2e/smoke.mjs"
  },
  "dependencies": {
    "@expo/log-box": "^58.0.12",
    "@expo/metro-runtime": "^58.0.14",
    "@tanstack/react-query": "^5.104.3",
    "expo": "~58.0.13",
    "expo-constants": "~58.0.12",
    "expo-haptics": "~58.0.7",
    "expo-linking": "~58.0.13",
    "expo-navigation-bar": "~58.0.4",
    "expo-router": "~58.0.22",
    "expo-secure-store": "~58.0.2",
    "expo-splash-screen": "~58.0.10",
    "expo-status-bar": "~58.0.3",
    "expo-system-ui": "~58.0.6",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-native": "0.88.0",
    "react-native-safe-area-context": "~5.10.1",
    "react-native-screens": "~4.30.0",
    "react-native-svg": "^15.16.0",
    "react-native-web": "~0.21.4"
  },
  "devDependencies": {
    "@testing-library/react-native": "^14.1.0",
    "@types/jest": "^30.0.0",
    "@types/react": "~19.3.0",
    "eslint": "^9.39.5",
    "eslint-config-expo": "~58.0.4",
    "jest": "^30.5.2",
    "jest-expo": "~58.0.11",
    "openapi-typescript": "^7.13.0",
    "playwright": "1.56.1",
    "prettier": "^3.9.10",
    "typescript": "~6.0.3"
  },
  "overrides": {
    "openapi-typescript": {
      "typescript": "$typescript"
    },
    "xcode": {
      "uuid": "^11.1.1"
    }
  }
}
