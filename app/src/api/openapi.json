  "components": {
    "schemas": {
      "Accepted": {
        "properties": {
          "status": {
            "type": "string",
            "const": "accepted",
            "title": "Status",
            "default": "accepted"
          }
        },
        "type": "object",
        "title": "Accepted"
      },
      "Category": {
        "type": "string",
        "enum": [
          "blitz",
          "rapid"
        ],
        "title": "Category"
      },
      "ChallengeIn": {
        "properties": {
          "opponent": {
            "type": "string",
            "pattern": "^[A-Za-z0-9_-]{1,20}$",
            "title": "Opponent"
          },
          "time_control": {
            "type": "string",
            "enum": [
              "3+2",
              "5+3",
              "10+5",
              "15+10"
            ],
            "title": "Time Control"
          },
          "rated": {
            "type": "boolean",
            "title": "Rated",
            "default": false
          },
          "side": {
            "anyOf": [
              {
                "type": "string",
                "enum": [
                  "goat",
                  "tiger",
                  "random"
                ]
              },
              {
                "type": "null"
              }
            ],
            "title": "Side"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "opponent",
          "time_control"
        ],
        "title": "ChallengeIn"
      },
      "ChallengeList": {
        "properties": {
          "incoming": {
            "items": {
              "$ref": "#/components/schemas/ChallengeOut"
            },
            "type": "array",
            "title": "Incoming"
          },
          "outgoing": {
            "items": {
              "$ref": "#/components/schemas/ChallengeOut"
            },
            "type": "array",
            "title": "Outgoing"
          }
        },
        "type": "object",
        "required": [
          "incoming",
          "outgoing"
        ],
        "title": "ChallengeList"
      },
      "ChallengeOut": {
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid",
            "title": "Id"
          },
          "challenger": {
            "$ref": "#/components/schemas/PlayerOut"
          },
          "opponent": {
            "$ref": "#/components/schemas/PlayerOut"
          },
          "time_control": {
