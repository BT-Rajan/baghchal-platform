# Production settings for deploy/compose.prod.yaml. Copy to deploy/.env and fill in.
# Never commit deploy/.env.

# Where players reach the game. DNS for this name must point at this machine.
DOMAIN=play.example.com
ACME_EMAIL=admin@example.com          # Let's Encrypt contacts this address about certificates

# Long random values, e.g. `openssl rand -base64 32`.
DB_PASSWORD=
DB_ROOT_PASSWORD=
METRICS_TOKEN=                         # also write it to deploy/monitoring/metrics-token

# Outgoing mail (sign-up and password links). Use a provider with SPF and DKIM set up for the
# sending domain, or the links land in spam.
MAIL_FROM=Bagh Chal <no-reply@example.com>
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=

# Who runs the service, as the privacy policy and terms name them (server legal/texts).
# The server will not start in production without every one.
OPERATOR_NAME=Example Games Private Limited
OPERATOR_ADDRESS=Registered office, street, city, state, PIN, India
CONTACT_EMAIL=support@example.com
GRIEVANCE_OFFICER=Name of the Grievance Officer   # IT Rules 2021 and the DPDP Act
GRIEVANCE_EMAIL=grievance@example.com
JURISDICTION_CITY=Bengaluru                       # courts named in the terms
HOSTING_PROVIDER=Name of the hosting company
HOSTING_LOCATION=India                            # where the servers and backups are
EMAIL_PROVIDER=Name of the email provider

# Optional.
API_REPLICAS=2                         # API servers behind Caddy
SENTRY_DSN=                            # report errors to Sentry or GlitchTip
BLOCKED_USERNAME_WORDS=[]              # e.g. ["word1","word2"]
BACKUP_AT=03:15                        # UTC time of the nightly database dump
BACKUP_KEEP_DAYS=14
