# Server settings, read from the environment (all optional in development).
# (With pm2 and runonce.sh, settings live in bhagchal2.env, and the email provider's in .env.)
# Production refuses to start unless the database is MySQL/MariaDB, Redis and SMTP are set,
# and URLs are https.
BAGHCHAL_ENVIRONMENT=development
BAGHCHAL_DATABASE_URL=sqlite+aiosqlite:///./baghchal.db
# BAGHCHAL_DATABASE_URL=mysql+asyncmy://user:password@localhost/baghchal
# BAGHCHAL_REDIS_URL=redis://localhost:6379/0
BAGHCHAL_PUBLIC_BASE_URL=http://localhost:8081
BAGHCHAL_ALLOWED_ORIGINS=["http://localhost:8081"]
BAGHCHAL_MAIL_BACKEND=console
# BAGHCHAL_MAIL_BACKEND=smtp
# BAGHCHAL_MAIL_FROM=ClawPlay <no-reply@example.com>
# BAGHCHAL_SMTP_HOST=smtp.example.com
# BAGHCHAL_SMTP_PORT=587
# BAGHCHAL_SMTP_USERNAME=
# BAGHCHAL_SMTP_PASSWORD=
BAGHCHAL_LOG_JSON=false

# Optional.
# BAGHCHAL_REDIS_MAX_CONNECTIONS=100          # per server process; commands wait when all are busy
# BAGHCHAL_BLOCKED_USERNAME_WORDS=["word1","word2"]   # refused in usernames (case, digits, _ and - ignored)
# BAGHCHAL_COMPUTER_WORKERS=2                 # processes searching computer moves (CPU cores)
# BAGHCHAL_FAIR_PLAY_WORKERS=1                # processes reviewing finished rated games
# BAGHCHAL_METRICS_TOKEN=                    # enables GET /metrics for Prometheus (Bearer token)
# BAGHCHAL_ANDROID_CERT_SHA256=["FA:C6:…"]   # the Android app's signing keys: its links open the app
#                                            # (docs/operations.md, "Links that open the Android app")
# Who runs the service, quoted by the privacy policy and terms (required in production):
# BAGHCHAL_OPERATOR_NAME=  BAGHCHAL_OPERATOR_ADDRESS=  BAGHCHAL_CONTACT_EMAIL=
# BAGHCHAL_GRIEVANCE_OFFICER=  BAGHCHAL_GRIEVANCE_EMAIL=  BAGHCHAL_JURISDICTION_CITY=
# BAGHCHAL_HOSTING_PROVIDER=  BAGHCHAL_HOSTING_LOCATION=  BAGHCHAL_EMAIL_PROVIDER=
# BAGHCHAL_SENTRY_DSN=                       # report unexpected errors (no personal data)
# BAGHCHAL_SENTRY_TRACES_SAMPLE_RATE=0.0
# BAGHCHAL_SECRETS_KEY=                      # any long random string; encrypts the Razorpay keys
#                                            # an admin enters in the app (Settings → Payments)
